{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finai.local/ontology-catalog.schema.json",
  "title": "G8 Ontology Catalog",
  "description": "Palantir-like object/link/interface registry. Business identities are G8 IDs. External IRIs only via alignments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "catalog_version", "status", "interfaces", "object_types", "link_types", "object_sets", "invariants"],
  "properties": {
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["SPEC_ACCEPTED", "CANDIDATE", "SUPERSEDED"] },
    "coa_pin_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interfaceType" } },
    "object_types": { "type": "array", "items": { "$ref": "#/$defs/objectType" } },
    "link_types": { "type": "array", "items": { "$ref": "#/$defs/linkType" } },
    "object_sets": { "type": "array", "items": { "$ref": "#/$defs/objectSet" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/functionType" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionType" } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "federation": { "type": "object" }
  },
  "$defs": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type"],
      "properties": {
        "name": { "type": "string" },
        "value_type": { "type": "string" },
        "required": { "type": "boolean" },
        "derived": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "interfaceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "properties"],
      "properties": {
        "api_name": { "type": "string" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "type_group", "implements", "primary_key", "properties"],
      "properties": {
        "api_name": { "type": "string" },
        "type_group": { "type": "string" },
        "implements": { "type": "array", "items": { "type": "string" } },
        "primary_key": { "type": "string" },
        "title_property": { "type": "string" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      }
    },
    "linkType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "from_type", "to_type", "cardinality"],
      "properties": {
        "api_name": { "type": "string" },
        "from_type": { "type": "string" },
        "to_type": { "type": "string" },
        "cardinality": { "enum": ["ONE_TO_ONE", "ONE_TO_MANY", "MANY_TO_ONE", "MANY_TO_MANY"] },
        "constraint": { "type": "string" }
      }
    },
    "objectSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "base_type"],
      "properties": {
        "api_name": { "type": "string" },
        "base_type": { "type": "string" },
        "default_filters": { "type": "array", "items": { "type": "string" } }
      }
    },
    "functionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "input_grain", "output"],
      "properties": {
        "api_name": { "type": "string" },
        "input_grain": { "type": "string" },
        "output": { "type": "string" },
        "forbidden": { "type": "string" }
      }
    },
    "actionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_name", "changes_authority"],
      "properties": {
        "api_name": { "type": "string" },
        "changes_authority": { "type": "boolean" },
        "nyx_may_execute": { "type": "boolean" }
      }
    }
  }
}
