{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finai.local/source-authority.schema.json",
  "title": "FinAI Source Authority Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "source_kind",
    "scope",
    "evidence",
    "observed_fields"
  ],
  "properties": {
    "contract_id": { "type": "string", "format": "uuid" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "source_kind": {
      "enum": ["TRIAL_BALANCE", "GENERAL_LEDGER", "DATABASE", "DOCUMENT"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "legal_entity_id", "period", "currency"],
      "properties": {
        "tenant_id": { "type": "string", "format": "uuid" },
        "legal_entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "period": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "content_sha256", "locator"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observed_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source_path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "semantic_type": { "type": ["string", "null"] }
        }
      }
    }
  }
}
