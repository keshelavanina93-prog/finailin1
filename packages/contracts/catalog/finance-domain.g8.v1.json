  "account_dimension_policies": [
    {
      "account_family_pattern": "^7310(?:\\.|$)",
      "required_dimensions": [
        "cost_article",
        "department"
      ],
      "observed_slot_order": [
        "cost_article",
        "department"
      ],
      "evidence_state": "OBSERVED_LABEL_ONLY",
      "slot_note": "Base sheet positions are observed only; posting order becomes binding only when RULE_EVIDENCED."
    },
    {
      "account_family_pattern": "^7410(?:\\.|$)",
      "required_dimensions": [
        "department",
        "cost_article"
      ],
      "observed_slot_order": [
        "department",
        "cost_article"
      ],
      "evidence_state": "OBSERVED_LABEL_ONLY",
      "slot_note": "7410 preserves the opposite Base column order observed for 73/82 families."
    },
    {
      "account_family_pattern": "^3110(?:\\.|$)",
      "required_dimensions": [
        "counterparty",
        "contract"
      ],
      "observed_slot_order": [
        "counterparty",
        "contract"
      ],
      "evidence_state": "OBSERVED_LABEL_ONLY",
      "slot_note": "Counterparty and contract are required only after a reviewed rule receipt."
    },
    {
      "account_family_pattern": "^1610(?:\\.|$)",
      "required_dimensions": [
        "product",
        "warehouse"
      ],
      "observed_slot_order": [
        "product",
        "warehouse"
      ],
      "evidence_state": "OBSERVED_LABEL_ONLY",
      "slot_note": "Nomenclature/product and warehouse labels do not become universal subkonto slots."
    }
  ],
  "traceability": {
    "path": [
      "SourceEvidence",
      "SourceRecord",
      "SourceDocument",
      "CanonicalJournalEntry",
      "CanonicalJournalLine",
      "AccountDimensionPolicy",
      "BudgetArticle",
      "ReportingLine"
    ],
    "cash_flow_condition": "CashFlowArticle is required only when an evidenced cash movement exists.",
    "unknown_state": "UNKNOWN",
    "tb_boundary": "Trial balance alone cannot authorize cash flow or a full statement.",
    "projection_boundary": "CORPORATE_MR and PETROLEUM_OPERATING_PL are separate versioned projections over the same identities.",
    "grain_boundary": "No transaction drill may be invented from ACCOUNT_PERIOD."
  }
