{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finai.local/canonical-journal-line.schema.json",
  "title": "Canonical Journal Line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "entry_id", "line_no", "legal_entity_id", "ledger_id", "period_id",
    "effective_date", "local_account_id", "side", "amount_transaction",
    "currency_transaction_id", "source_module", "scenario_version_id",
    "authority_state", "epistemic", "grain", "source_record_ids"
  ],
  "properties": {
    "id": { "type": "string" },
    "entry_id": { "type": "string" },
    "line_no": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string" },
    "legal_entity_id": { "type": "string" },
    "ledger_id": { "type": "string" },
    "period_id": { "type": "string" },
    "effective_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "local_account_id": { "type": "string" },
    "side": { "enum": ["DR", "CR"] },
    "amount_transaction": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "currency_transaction_id": { "type": "string" },
    "amount_functional": { "type": ["string", "null"] },
    "currency_functional_id": { "type": ["string", "null"] },
    "quantity": { "type": ["string", "null"] },
    "unit_id": { "type": ["string", "null"] },
    "source_module": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9", "M10", "M11", "M12", "M13", "M14", "M15"] },
    "source_document_id": { "type": ["string", "null"] },
    "scenario_version_id": { "type": "string" },
    "mapping_version_id": { "type": ["string", "null"] },
    "fs_mapping_id": { "type": ["string", "null"] },
    "intercompany_partner_id": { "type": ["string", "null"] },
    "dimension_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "member_id"],
        "properties": {
          "dimension": { "type": "string" },
          "member_id": { "type": "string" },
          "unknown": { "type": "boolean" }
        }
      }
    },
    "authority_state": { "enum": ["CANDIDATE", "REVIEWED", "ACCEPTED", "REJECTED", "SUPERSEDED", "WITHDRAWN"] },
    "epistemic": { "enum": ["OBSERVED", "DERIVED", "INFERRED", "UNAVAILABLE"] },
    "grain": { "const": "JOURNAL_LINE" },
    "source_record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
